# Copy this file to ".env" and fill in the values. This file stays on your machine
# and is git-ignored.

# --- Database (required) ---
# Supabase connection string: Supabase dashboard -> your project -> Connect -> ORMs/URI,
# or Project Settings -> Database -> Connection string. Use the "Session pooler" /
# transaction pooler URI and put your database password in it.
# Example: postgresql://postgres.<ref>:<password>@aws-0-us-east-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Gemini (food vision) ---
# Free key at https://aistudio.google.com/apikey. Without it, runs in MOCK mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- USDA macro grounding (optional) ---
# DEMO_KEY works for light use; your own free key (https://fdc.nal.usda.gov/api-key-signup)
# is more reliable.
USDA_API_KEY=DEMO_KEY

# Note: daily targets are now per-user (set in the app's Settings), not here.
