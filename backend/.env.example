# Copy this file to ".env" and fill in your key(s).
# With NO key set, SnapMacro runs in MOCK mode (simulated analysis) so you can
# try the full flow immediately.

# Google Gemini API key — get one free at https://aistudio.google.com/apikey
# Without it, the app uses mock estimates.
GEMINI_API_KEY=

# Vision model. Flash-Lite is the cheapest viable option (~$0.0002-0.001 / photo).
GEMINI_MODEL=gemini-2.5-flash-lite

# USDA FoodData Central API key for macro grounding (optional).
# "DEMO_KEY" works for light use; get your own free at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=DEMO_KEY

# Access password. Leave BLANK for local use. Set it when deploying publicly so random
# visitors can't use (and bill) your Gemini key.
APP_PASSWORD=

# Your daily targets (used by the widget to show "remaining").
TARGET_CALORIES=2600
TARGET_PROTEIN=190
TARGET_CARBS=280
TARGET_FAT=80
